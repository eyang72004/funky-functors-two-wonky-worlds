
digraph ContravariantComposition {
    rankdir=LR;
    node [shape=ellipse, fontsize=14];

    g_of_f  [label="g_o_f: X -> Z"];
    Fg_of_f [label="F(g_o_f): F(Z) -> F(X)"];
    FfFg    [label="F(f) o F(g): F(Z) -> F(X)"];

    g_of_f  -> Fg_of_f [label="F on morphisms"];
    Fg_of_f -> FfFg    [style=dashed, label="must equal"];

    labelloc="t";
    label="Composition law (contravariant): F(g_o_f) = F(f) o F(g).";
}
