
digraph CppVectorFunctor {
    rankdir=LR;
    node [shape=ellipse, fontsize=12];

    subgraph cluster_Types {
        label="Category: C++ types and functions";
        style=rounded;
        X [label="int (X)"];
        Y [label="int (Y)"];
        X -> Y [label="f: int -> int"];
    }

    subgraph cluster_Containers {
        label="Endofunctor F(T) = std::vector<T>";
        style=rounded;
        FX [label="std::vector<int> (F(X))"];
        FY [label="std::vector<int> (F(Y))"];
        FX -> FY [label="F(f): elementwise f"];
    }

    X -> FX [style=dashed, label="F on objects"];
    Y -> FY [style=dashed, label="F on objects"];

    labelloc="t";
    label="C++: std::vector<T> as a covariant endofunctor on C++ types.";
}
