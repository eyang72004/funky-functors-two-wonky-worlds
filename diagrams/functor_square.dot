
digraph FunctorSquare {
    rankdir=LR;
    node [shape=ellipse, fontsize=12];

    subgraph cluster_C {
        label="Square in C (commutative)";
        style=rounded;
        CX [label="X"];
        CY [label="Y"];
        CZ [label="Z"];
        CW [label="W"];

        CX -> CY [label="f"];
        CX -> CZ [label="h"];
        CY -> CW [label="g"];
        CZ -> CW [label="k"];

        // Implicitly, g o f = k o h
    }

    subgraph cluster_D {
        label="Image square in D: F(g) o F(f) = F(k) o F(h)";
        style=rounded;
        FX [label="F(X)"];
        FY [label="F(Y)"];
        FZ [label="F(Z)"];
        FW [label="F(W)"];

        FX -> FY [label="F(f)"];
        FX -> FZ [label="F(h)"];
        FY -> FW [label="F(g)"];
        FZ -> FW [label="F(k)"];
    }

    // object mapping (dashed)
    CX -> FX [style=dashed];
    CY -> FY [style=dashed];
    CZ -> FZ [style=dashed];
    CW -> FW [style=dashed];

    labelloc="t";
    label="A functor F sends commutative diagrams in C to commutative diagrams in D.";
}
